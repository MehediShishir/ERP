<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="HRSite.master.cs" Inherits="HR.HRSite" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <title runat="server">ERP System</title>
    <link href="Content/HRSite.css" rel="stylesheet" />
</head>

<body>
    <form id="form1" runat="server">

        <!-- HEADER + NAV BAR -->
        <header class="erp-header">
            <h1 class="erp-title">ERP SYSTEM</h1>

            <nav class="erp-nav">
                <asp:Button ID="btnHome" runat="server" Text="Home"
                    CssClass="nav-btn" OnClick="btnHome_Click" />
                <asp:Button ID="btnAttendance" runat="server" Text="Attendance"
                    CssClass="nav-btn" OnClick="btnAttendance_Click" />

                <asp:Button ID="btnDepartmentSetup" runat="server" Text="Department Setup"
                    CssClass="nav-btn" OnClick="btnDepartmentSetup_Click" />

                <asp:Button ID="btnDesignation" runat="server" Text="Designation"
                    CssClass="nav-btn" OnClick="btnDesignation_Click" />

                <asp:Button ID="btnEmployeeInformation" runat="server" Text="Employee Information"
                    CssClass="nav-btn" OnClick="btnEmployeeInformation_Click" />

                <asp:Button ID="btnLeaveApplication" runat="server" Text="Leave Application"
                    CssClass="nav-btn" OnClick="btnLeaveApplication_Click" />
                <asp:Button ID="btnLogout" runat="server" Text="Logout"
                    CssClass="nav-btn nav-btn-logout" OnClick="btnLogout_Click" />
            </nav>
        </header>

        <!-- CONTENT -->
        <main class="body-content">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server"></asp:ContentPlaceHolder>
        </main>

        <!-- FOOTER -->
        <footer class="erp-footer">
            <p>&copy; <%: DateTime.Now.Year %> - HR Module</p>
        </footer>

    </form>
</body>
</html>
